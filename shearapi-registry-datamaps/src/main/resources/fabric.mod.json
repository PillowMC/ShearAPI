{
	"schemaVersion": 1,
	"id": "shearapi-registry-datamaps",
	"version": "${version}",
	"name": "Shear API (Registry-datamaps)",
	"description": "Port NeoForge \"API\" of registry-datamaps to Fabric",
	"authors": [
		"PillowMC"
	],
	"contact": {
		"homepage": "https://github.com/PillowMC/ShearAPI",
		"sources": "https://github.com/PillowMC/ShearAPI"
	},
	"license": "LGPL-2.1",
	"icon": "assets/shearapi-registry-datamaps/icon.png",
	"environment": "*",
	"depends": {
		"fabricloader": ">=0.15.6",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"shearapi-conditions": "~${version}",
		"shearapi-registries": "~${version}",
		"shearapi-network": "~${version}"
	},
	"entrypoints": {
		"main": ["net.pillowmc.shearapi.registries.datamaps.DataMapManager::shearapi$fabricInitialize"],
		"client": ["net.pillowmc.shearapi.registries.datamaps.client.ClientDataMapManager::shearapi$fabricClientInitialize"]
	},
	"accessWidener": "shearapi-registry-datamaps.accesswidener",
	"custom": {
		"modmenu": {
			"parent": "shearapi",
      "badges": ["library"]
		},
		"loom:injected_interfaces": {
			"net/minecraft/class_7225$class_7226": ["net/pillowmc/shearapi/registries/datamaps/injections/GetDataInjection<TT;>"],
			"net/minecraft/class_6880": ["net/pillowmc/shearapi/registries/datamaps/injections/IHolderInjection<TT;>"]
		}
	}
}
