  "name": "Shear API (FML Stuff)",
  "description": "Deal with stuff things if FML installed",
  "authors": [
    "PillowMC"
  ],
  "contact": {
    "homepage": "https://github.com/PillowMC/ShearAPI",
    "sources": "https://github.com/PillowMC/ShearAPI"
  },
  "license": "LGPL-2.1",
  "icon": "assets/shearapi-fmlstuff/icon.png",
  "environment": "*",
  "depends": {
