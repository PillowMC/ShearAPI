	"authors": [
		"PillowMC"
	],
	"contact": {
		"homepage": "https://github.com/PillowMC/ShearAPI",
		"sources": "https://github.com/PillowMC/ShearAPI"
	},
	"license": "LGPL-2.1",
	"icon": "assets/shearapi-holderset/icon.png",
	"environment": "*",
